#!/usr/bin/env python3
"""On, off and status for the Jev model router.

    routerctl on        # start sizing messages (posts message text to api.typesafe.ai)
    routerctl off       # stop; the session behaves as if the router were not installed
    routerctl status    # on or off, counts per lane, cost, latency added
    routerctl log [N]   # the last N decisions (default 15)
    routerctl skills    # rebuild and list the skills the router may suggest
    routerctl eval [F]  # run eval cases (default eval.json, else eval.example.json) live
"""

import json
import sys
import time
from collections import Counter
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import route  # noqa: E402

FLAG, STATS = route.FLAG, route.STATS
WARNING = ("While the router is on, every message you type is posted to TypeSafe "
           "(api.typesafe.ai) to be sized. Turn it off for private work: routerctl off")


def rows() -> list[dict]:
    if not STATS.exists():
        return []
    out = []
    for n, line in enumerate(STATS.read_text().splitlines(), 1):
        try:
            out.append(json.loads(line))
        except ValueError:
            print(f"  (skipped unreadable line {n} in {STATS})")
    return out


def on() -> None:
    route.ROOT.mkdir(parents=True, exist_ok=True)
    FLAG.write_text(time.strftime("%Y-%m-%dT%H:%M:%S\n"))
    print("Router ON.\n" + WARNING)
    if not route.api_key():
        print("TYPESAFE_API_KEY is not set, so nothing will be routed until it is.")


def off() -> None:
    FLAG.unlink(missing_ok=True)
    print("Router OFF. Nothing leaves the machine.")


def status() -> None:
    print(f"\nModel router: {'ON' if FLAG.exists() else 'OFF'}")
    if FLAG.exists():
        print("  " + WARNING)
        print(f"  key: {'set' if route.api_key() else 'NOT SET'}")
    r = rows()
    if not r:
        print("\nNo decisions recorded yet.\n")
        return
    lanes = Counter((x.get("lane") or ("skill" if x.get("skill") else "kept here")) for x in r)
    print(f"\n{len(r)} decisions")
    for lane, n in lanes.most_common():
        print(f"  {lane:<16} {n}")
    cost = sum(float(x.get("cost_usd") or 0) for x in r)
    lat = [int(x["latency_ms"]) for x in r if x.get("latency_ms")]
    print(f"\nJev cost: ${cost:.4f}")
    if lat:
        print(f"Latency added: mean {sum(lat) // len(lat)} ms, worst {max(lat)} ms")
    errors = [x for x in r if not x.get("routed") and x.get("size") is None]
    if errors:
        print(f"Failures: {len(errors)}, last: {errors[-1].get('reason')}")
    print()


def show_log(n: int) -> None:
    for x in rows()[-n:]:
        where = x.get("agent") or (f"skill {x['skill']}" if x.get("skill") else "-")
        print(f"{x.get('ts', '?')}  {str(x.get('size')):<9} {where:<22} "
              f"{x.get('reason', '')[:40]:<40}  {x.get('preview') or ''}")


def skills() -> None:
    route.SKILLS_CACHE.unlink(missing_ok=True)
    cat = route.catalogue()
    chars = sum(len(k) + len(v) for k, v in cat.items())
    print(f"{len(cat)} skills, about {chars // 4} tokens per message:")
    for name in sorted(cat):
        print(f"  {name}")


def evaluate(path: Path) -> None:
    key = route.api_key()
    if not key:
        sys.exit("Set TYPESAFE_API_KEY first.")
    cases = json.loads(path.read_text())["cases"]
    hits = 0
    for c in cases:
        try:
            d = route.decide(c["message"], key)
            got = d["agent"] or "kept here"
        except Exception as ex:
            got = f"error: {type(ex).__name__}"
        ok = got == c["expect"]
        hits += ok
        print(f"  {'ok  ' if ok else 'FAIL'} want {c['expect']:<22} got {got:<22} {c['message'][:50]}")
    print(f"\n{hits}/{len(cases)} right")


def main() -> None:
    args = sys.argv[1:] or ["status"]
    cmd = args[0]
    if cmd == "on":
        on()
    elif cmd == "off":
        off()
    elif cmd == "status":
        status()
    elif cmd == "log":
        show_log(int(args[1]) if len(args) > 1 else 15)
    elif cmd == "skills":
        skills()
    elif cmd == "eval":
        default = HERE / "eval.json"
        path = Path(args[1]) if len(args) > 1 else (default if default.exists()
                                                    else HERE / "eval.example.json")
        evaluate(path)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
